<script>
  document.body.dataset.lang = window.currentLang;
  if (
    window.currentLang !== 'arkham' &&
    window.currentLang !== 'en' &&
    window.currentLang !== 'zh' &&
    window.currentLang !== 'zh-tw'
  ) {
    const twitterCnEls = document.querySelectorAll('.twitter-cn');
    twitterCnEls.forEach(twitterCn => {
      twitterCn.remove();
    });
  }
</script>

<script>
  const isWeglotTranslate = false; // window.currentLang === 'ru' || window.currentLang === 'es';
  
  function changeDecodeWords() {
    if (isWeglotTranslate) {
      const lang = window.currentLang;
      const texts = window.i18nTexts[lang];
      if (!texts) return;
      document.querySelectorAll('[data-decode]').forEach(el => {
        const ref = el.innerText.toUpperCase();
        if (texts[ref]) {
          el.innerHTML = texts[ref];
          el.dataset.decode = texts[ref];
          el.dataset.decodeOriginalValue = ref;
        }
      });
      const generalTexts = window.i18nGeneralTexts[lang];
      document.querySelectorAll('[data-i18n-id]').forEach(el => {
        const ref = el.dataset.i18nId;
        if (generalTexts[ref]) {
          el.innerHTML = generalTexts[ref];
        }
      });
    } else {
      document.querySelectorAll('[data-decode]').forEach(el => {
        el.dataset.decode = el.innerText;
        // el.dataset.decodeOriginalValue = el.innerText;
      });
    }
  }
  changeDecodeWords();
  
  const lettersByLanguage = {
  	'en': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789',
    'ko': 'ㄱㄲㄴㄷㄸㄹㅁㅂㅃㅅㅆㅇㅈㅉㅊㅋㅌㅍㅎㅏㅓㅗㅜㅡㅣㅔㅐㅚㅟㅑㅕㅛㅠㅒㅖㅢㅘㅝㅙㅞ일이삼사오육칠팔구십',
    'ja': 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲいちにさんしよんごろくしちななはちきゅうくじゅう',
    'zh': '诶比西迪伊艾弗吉艾尺艾杰开艾勒艾马艾娜哦屁吉吾艾儿艾丝提伊吾维豆贝尔维艾克斯吾艾贼德',
    'zh-tw': '诶比西迪伊艾弗吉艾尺艾杰开艾勒艾马艾娜哦屁吉吾艾儿艾丝提伊吾维豆贝尔维艾克斯吾艾贼德',
    'ru': 'АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ0123456789',
  	'es': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789',
  	'tr': 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789',
  }

  const startsByLanguage = {
  	'en': ['1e4', '1t6', '1h0', '3fr', '3yu', '3vw', 'bc1', '0x1', '0x5', '0x7'],
    'ko': ['십', '이', 'ㅞ'],
    'ja': ['ち', 'ち', 'き', 'じ'],
    'zh': ['贼', '艾', '维', '丝'],
    'zh-tw': ['贼', '艾', '维', '丝'],
    'ru': ['1', '3', 'В', '0'],
    'es': ['1e4', '1t6', '1h0', '3fr', '3yu', '3vw', 'bc1', '0x1', '0x5', '0x7'],
    'tr': ['1e4', '1t6', '1h0', '3fr', '3yu', '3vw', 'bc1', '0x1', '0x5', '0x7'],
  }
  
  const higherThanMap = {
  	'en': 2,
    'ko': 0,
    'ja': 0,
    'zh': 0,
    'zh-tw': 0,
    'ru': 0,
    'es': 2,
    'tr': 2,
  }
  
  function decodeAnimation(el, isHover, timeEachLetter = 100) {
    let currentLang = window.currentLang === 'arkham' ? 'en' : window.currentLang;
    if (el.dataset.originalText === el.dataset.decodeOriginalValue) currentLang = 'en';
    const letters = lettersByLanguage[currentLang].split('');
    const start = startsByLanguage[currentLang];
    const firstLetters = start[Math.floor(Math.random() * start.length)];

    function randomString(len, text, index) {
      let string = firstLetters;
      const higherThan = higherThanMap[currentLang];
      for (let i = 0; i < len; i++) {
        if (i > higherThan) {
          if (text[i] === ' ') {
            string += ' ';
          } else {
            string += letters[Math.floor(Math.random() * letters.length)];
          }
        }
      }
      return string.slice(index);
    }

    function getText(len, text) {
      let string = '';
      for (let i = 0; i < len; i++) {
        string += text[i];
      }
      return string;
    }

    function constructText(text, index) {
      setTimeout(function () {
        const merged = getText(index, text) + randomString(text.length, text, index);
        if (el.tagName.toLowerCase() === 'input') {
          el.value = merged;
        } else {
          el.innerHTML = merged;
        }
      }, index * timeEachLetter);
    }

    const text = isHover ? el.dataset.decode : el.dataset.decodeText;
    for (let i = 0, len = text.length; i <= len; i++) {
      constructText(text, i);
    };
  };

  function addDecodeHoverEvent() {
    const els = document.querySelectorAll('[data-decode]');
    els.forEach(el => el.addEventListener('mouseover', () => { decodeAnimation(el, true); }));
  }
  addDecodeHoverEvent();
</script>

<script>
  function startWeglot() {
    const decodeEls = Array.from(document.querySelectorAll('[data-decode]'));
    const decodeTextEls = Array.from(document.querySelectorAll('[data-decode-text]'));
    const textsToDecode = [];

    function translateEachUsingWeglot() {
      const current = textsToDecode.shift();
      if (!current.text) return;
      /* Weglot.translate(
        {
          words: [{
            t: 1,
            w: current.text,
          }],
          languageTo: Weglot.getCurrentLang(),
        },
        translatedText => {
          const el = document.getElementById(current.el.id);
          if (!el) return;
          el.dataset[current.type] = translatedText;
          el.innerText = translatedText;
        }
      ); */
      if (textsToDecode.length) {
        window.setTimeout(translateEachUsingWeglot, 120);
      }
    }

    function copyTextToDecode() {
      textsToDecode.forEach(current => {
        const el = document.getElementById(current.el.id);
        el.dataset[current.type] = el.tagName === 'INPUT' ? current.el.value : current.el.innerText;
      });
    }

    function updateInternalizationDecode() {
      decodeEls.forEach(el => {
        textsToDecode.push({
          text: el.dataset.originalText,
          el: el,
          type: 'decode',
        });
      });
      decodeTextEls.forEach(el => {
        textsToDecode.push({
          text: el.dataset.originalText,
          el: el,
          type: 'decodeText',
        });
      });
      if (window.location.host.indexOf('www.') === 0) {
        translateEachUsingWeglot();
      } else {
        copyTextToDecode();
      }
    }

    function createOriginalText() {
      decodeEls.forEach(el => {
        el.dataset.originalText = el.dataset.decode;
        el.id = `id-decode-${(Math.random() * Math.random()).toString().replace('.','')}`;
      });
      decodeTextEls.forEach(el => {
        el.dataset.originalText = el.dataset.decodeText;
        el.id = `id-decode-${(Math.random() * Math.random()).toString().replace('.','')}`;
      });
    }

    function addEventsInNav() {
      const menuLink = document.querySelector('.ph-hero__top__link.v--language');
      const mobileNav = document.querySelector('.navbar__links.w-nav-menu');
      const popupEl = document.querySelector('.language-popup');
      const menuLinkContact = document.querySelector('.ph-hero__top__link.v--contact');
      const popupElContact = document.querySelector('.contact-popup');
      const menuLinkPlatform = document.querySelector('.ph-hero__top__link.v--platform-mobile');
      const popupElPlatform = document.querySelector('.platform-popup');
      
      const links = document.querySelectorAll('.language-popup [data-lang]');
      let tempBlockAfterChange = false;
      Array.from(links).forEach(link => {
        link.addEventListener('click', () => {
          if (tempBlockAfterChange) return;
          tempBlockAfterChange = true;
          window.Weglot.switchTo(link.dataset.lang);
          popupEl.classList.remove('show');
          window.setTimeout(() => {
            tempBlockAfterChange = false;
          }, 5000);
          if (window.innerWidth < 992) {
          	const menuClose = document.querySelector('.menu-button.w-nav-button.w--open');
            if (menuClose) menuClose.click();
          }
        });
      });

      if (window.innerWidth < 992) {
        if (menuLink) menuLink.removeAttribute('href');
        
        if (menuLink) menuLink.addEventListener('click', () => {
          popupEl.classList.add('show');
          mobileNav.classList.add('zindex999');
        });

        if (popupEl) popupEl.addEventListener('click', () => {
          popupEl.classList.remove('show');
          mobileNav.classList.remove('zindex999');
        });
        
        if (menuLinkContact) menuLinkContact.addEventListener('click', () => {
          popupElContact.classList.add('show');
          mobileNav.classList.add('zindex999');
        });

        if (popupElContact) popupElContact.addEventListener('click', () => {
          popupElContact.classList.remove('show');
          mobileNav.classList.remove('zindex999');
        });
        
        if (menuLinkPlatform) menuLinkPlatform.addEventListener('click', () => {
          popupElPlatform.classList.add('show');
          mobileNav.classList.add('zindex999');
        });

        if (popupElPlatform) popupElPlatform.addEventListener('click', () => {
          popupElPlatform.classList.remove('show');
          mobileNav.classList.remove('zindex999');
        });
      }
    }


    createOriginalText();
    addEventsInNav();
    if (window.currentLang !== 'en') updateInternalizationDecode();
    /* window.Weglot.on("languageChanged", function(newLang, prevLang) {
      updateInternalizationDecode();
    }); */
  }
  // startWeglot();
</script>

<script src="//embed.typeform.com/next/embed.js" async defer></script>

<script>
  function cookiePrefsEvent() {
  	document.querySelectorAll('#cookie-prefs').forEach(cookiePrefsEl => {
    	cookiePrefsEl.addEventListener('click', () => {window.FsCC.banner.open()});
    });
  }
  cookiePrefsEvent();
</script>

<script>
  Array.from(document.querySelectorAll('.current-year')).forEach(el => {
  	el.innerHTML = new Date().getFullYear();
  });
</script></body></html>